{
  "name": "mahjongtournamentsuite-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/services/tournamentDates.test.js lib/models/globalRole.test.js lib/services/idCardsService.test.js",
    "proof:id-cards": "npm run build && node lib/scripts/createIdCardsProof.js",
    "verify:roles": "npm run build && node lib/scripts/verifyRolePermissions.js",
    "seed:countries": "npm run build && node lib/scripts/seedCountries.js",
    "seed:players": "npm run build && node --env-file=local-player-sync.env lib/scripts/seedPlayers.js",
    "normalize:player-names": "npm run build && node --env-file=local-player-sync.env lib/scripts/normalizePlayerNames.js",
    "reset:access": "npm run build && node lib/scripts/resetAccess.js",
    "sync:players": "npm run build && node --env-file=local-player-sync.env lib/scripts/syncPlayers.js",
    "watch": "tsc -w"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "pdfkit": "^0.16.0",
    "roboto-font": "^0.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.8.3"
  }
}
