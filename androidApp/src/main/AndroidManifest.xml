<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- App Check. Fill in the Android app of the Firebase project to turn it on. See docs/backend.md. -->
        <meta-data android:name="mts.appCheck.appId" android:value="" />
        <meta-data android:name="mts.appCheck.apiKey" android:value="" />
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TimerActivity"
            android:documentLaunchMode="always"
            android:exported="false"
            android:taskAffinity="com.etologic.mahjongtournamentsuite.timer" />
        <activity
            android:name=".RankingsActivity"
            android:documentLaunchMode="always"
            android:exported="false"
            android:taskAffinity="com.etologic.mahjongtournamentsuite.rankings" />
    </application>

</manifest>
