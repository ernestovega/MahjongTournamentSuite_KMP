<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only debug builds. Instrumented tests reach the local test backend on the host computer over http. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- scripts/run-e2e-parallel.py uses adb reverse to 127.0.0.1 when an emulator does not reach 10.0.2.2. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
