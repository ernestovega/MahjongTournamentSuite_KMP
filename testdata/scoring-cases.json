{
  "about": "Shared scoring cases. The server tests (firebase/functions/src/services/scoringCases.test.ts) and the app tests (adminApp and playerApp jvmTest ScoringCasesTest) all check these results, so the scoring of the server and of the apps cannot drift apart. Seats are east, south, west, north. A hand with no expected result does not count. 'result' is the hand without penalties; it is the same as 'scores' when missing. Table points use a comma for decimals.",
  "seats": ["11", "12", "13", "14"],
  "hands": [
    { "name": "a discard pays score plus 8, the others pay 8", "hand": { "winner": "11", "loser": "12", "score": "10" }, "scores": [34, -18, -8, -8] },
    { "name": "a self-drawn hand takes score plus 8 from each seat", "hand": { "winner": "13", "score": "8" }, "scores": [-16, -16, 48, -16] },
    { "name": "a loser of '-' means self-drawn", "hand": { "winner": "14", "loser": "-", "score": "9" }, "scores": [-17, -17, -17, 51] },
    { "name": "a high self-drawn hand", "hand": { "winner": "11", "score": "88" }, "scores": [288, -96, -96, -96] },
    { "name": "a draw changes nothing", "hand": { "score": "0" }, "scores": [0, 0, 0, 0] },
    { "name": "a draw cannot be a chicken hand", "hand": { "score": "0", "chicken": true }, "scores": null },
    { "name": "a chicken hand up to 12 counts", "hand": { "winner": "12", "loser": "11", "score": "12", "chicken": true }, "scores": [-20, 36, -8, -8] },
    { "name": "a chicken hand over 12 does not count", "hand": { "winner": "12", "loser": "11", "score": "13", "chicken": true }, "scores": null },
    { "name": "a score below 8 does not count", "hand": { "winner": "11", "loser": "12", "score": "7" }, "scores": null },
    { "name": "a winner with score 0 does not count", "hand": { "winner": "11", "score": "0" }, "scores": null },
    { "name": "a score that is not a number does not count", "hand": { "winner": "11", "loser": "12", "score": "abc" }, "scores": null },
    { "name": "a score with a plus sign does not count", "hand": { "winner": "11", "loser": "12", "score": "+10" }, "scores": null },
    { "name": "a score with decimals does not count", "hand": { "winner": "11", "loser": "12", "score": "10.5" }, "scores": null },
    { "name": "a loser without a winner does not count", "hand": { "loser": "12", "score": "10" }, "scores": null },
    { "name": "the winner cannot be the loser", "hand": { "winner": "11", "loser": "11", "score": "10" }, "scores": null },
    { "name": "a winner who is not at the table does not count", "hand": { "winner": "99", "loser": "12", "score": "10" }, "scores": null },
    { "name": "a loser who is not at the table does not count", "hand": { "winner": "11", "loser": "99", "score": "10" }, "scores": null },
    { "name": "a hand with only the chicken mark does not count", "hand": { "chicken": true }, "scores": null },
    { "name": "an empty hand does not count, even with a penalty", "hand": { "penalties": ["-10", "", "", ""] }, "scores": null },
    { "name": "spaces around the values are ignored", "hand": { "winner": " 11 ", "loser": " 12 ", "score": " 10 " }, "scores": [34, -18, -8, -8] },
    { "name": "penalties add to the result, several joined with ';'", "hand": { "winner": "11", "loser": "12", "score": "10", "penalties": ["-10;-5", "", "-20", ""] }, "scores": [19, -18, -28, -8], "result": [34, -18, -8, -8] },
    { "name": "a penalty part that is not a number counts as 0", "hand": { "winner": "11", "loser": "12", "score": "10", "penalties": ["abc;-5", "", "", ""] }, "scores": [29, -18, -8, -8], "result": [34, -18, -8, -8] },
    { "name": "a penalty with a plus sign counts as 0", "hand": { "winner": "11", "loser": "12", "score": "10", "penalties": ["+5;-5", "", "", ""] }, "scores": [29, -18, -8, -8], "result": [34, -18, -8, -8] },
    { "name": "a draw keeps its penalties", "hand": { "score": "0", "penalties": ["", "", "", "-30"] }, "scores": [0, 0, 0, -30], "result": [0, 0, 0, 0] }
  ],
